# редакторские автосохранения
*.save
*.bak
*.backup

# fish rewrites this on every `set -U` (and leaves fish_variables<random>
# temp files around) - tide settings live in config/fish/tide-settings.fish
config/fish/fish_variables*

# Caelestia per-monitor overrides (output names differ between machines)
config/caelestia/monitors/

# generated by caelestia-cli from the current wallpaper
config/hypr/scheme/
