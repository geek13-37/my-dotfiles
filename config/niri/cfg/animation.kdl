animations {
    workspace-switch {
        spring damping-ratio=0.9 stiffness=900 epsilon=0.0001
    }

    window-open {
        spring damping-ratio=0.95 stiffness=500 epsilon=0.0001
    }

    window-close {
        spring damping-ratio=0.95 stiffness=500 epsilon=0.0001
    }

    horizontal-view-movement {
	spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1300 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1300 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.7 stiffness=1400 epsilon=0.001
    }

    screenshot-ui-open {
        duration-ms 100
        curve "ease-out-cubic"
    }

    overview-open-close {
        spring damping-ratio=1.2 stiffness=1200 epsilon=0.0001
    }
}

