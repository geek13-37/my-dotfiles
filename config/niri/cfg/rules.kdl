window-rule {
    geometry-corner-radius 20 // Set every window radius to 20
    clip-to-geometry true
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Floating Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

//window-rule {
//    match app-id="org.telegram.desktop"
//    open-floating true
//}   

// Browser picture-in-picture video popups (Firefox, Chromium-based) - float
// them instead of tiling, so video stays on top of the layout while you work.
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
        // blur false
    }
}

// NOTE: overrides the geometry-corner-radius set above (last matching
// window-rule wins per-property) - effective radius is 6, not 20.
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}
