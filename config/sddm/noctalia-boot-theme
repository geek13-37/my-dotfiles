#!/bin/bash
#
# Applies the active Noctalia palette to SDDM (where_is_my_sddm_theme) and Limine.
#
# Noctalia renders ~/.config/noctalia/templates/{sddm,limine}.conf into
# ~/.cache/noctalia/boot-theme/ and calls this script through `sudo -n`
# (see noctalia-boot-theme.sudoers). Because it runs as root without a password,
# it never copies user-provided text: it only picks known keys and writes
# strictly validated hex colours.

set -euo pipefail

user=${SUDO_USER:?run this via sudo}
home=$(getent passwd "$user" | cut -d: -f6)
src="$home/.cache/noctalia/boot-theme"

SDDM_THEME=/usr/share/sddm/themes/where_is_my_sddm_theme
LIMINE_CONFS=(/boot/EFI/limine/limine.conf /boot/EFI/BOOT/limine.conf
              /boot/limine/limine.conf /boot/limine.conf
              /efi/EFI/limine/limine.conf /efi/EFI/BOOT/limine.conf)

declare -A colour

# key=#rrggbb[;#rrggbb...] -> colour[key]=rrggbb[;rrggbb...], invalid lines dropped
read_colours() {
    colour=()
    [[ -r $1 ]] || return 0
    local k v p out
    while IFS='=' read -r k v; do
        [[ $k =~ ^[a-z_]+$ ]] || continue
        out=()
        IFS=';' read -ra parts <<<"$v"
        for p in "${parts[@]}"; do
            [[ $p =~ ^#[0-9a-fA-F]{6}$ ]] || continue 2
            out+=("${p#\#}")
        done
        colour[$k]=$(IFS=';'; echo "${out[*]}")
    done <"$1"
}

apply_sddm() {
    read_colours "$src/sddm.conf"
    [[ -d $SDDM_THEME && ${#colour[@]} -gt 0 ]] || return 0

    local -A map=(
        [background]=backgroundFill
        [text]=basicTextColor
        [input_background]=passwordInputBackground
        [input_border]=passwordInputBorderColor
        [cursor]=passwordCursorColor
        [password_text]=passwordTextColor
        [wrong_password]=wrongPasswordBorderColor
    )
    {
        echo "# Generated by noctalia-boot-theme - do not edit"
        echo "[General]"
        echo "font=JetBrainsMono NF"
        echo "helpFont=JetBrainsMono NF"
        echo "passwordCharacter=■"
        echo "passwordFontSize=48"
        echo "passwordInputWidth=0.4"
        echo "passwordInputRadius=0"
        echo "passwordInputBorderWidth=1"
        echo "wrongPasswordBorderRadius=0"
        echo "cursorBlinkAnimation=true"
        local k
        for k in "${!map[@]}"; do
            [[ -n ${colour[$k]:-} && ${colour[$k]} != *';'* ]] &&
                echo "${map[$k]}=#${colour[$k]}"
        done
    } >"$SDDM_THEME/theme.conf.user.tmp"
    mv "$SDDM_THEME/theme.conf.user.tmp" "$SDDM_THEME/theme.conf.user"
    chmod 644 "$SDDM_THEME/theme.conf.user"
    echo "sddm: updated $SDDM_THEME/theme.conf.user"
}

apply_limine() {
    read_colours "$src/limine.conf"
    [[ ${#colour[@]} -gt 0 ]] || return 0

    local keys=(backdrop term_background term_foreground term_background_bright
                term_foreground_bright interface_branding_colour interface_help_colour
                term_palette term_palette_bright)
    local block="# >>> noctalia colours (managed by noctalia-boot-theme)"$'\n'
    local k v
    for k in "${keys[@]}"; do
        v=${colour[$k]:-}
        [[ -n $v ]] || continue
        # term_background is TTRRGGBB; 00 = opaque
        [[ $k == term_background ]] && v="00$v"
        block+="$k: $v"$'\n'
    done
    block+="# <<< noctalia colours"

    local conf found=0 key_re
    key_re="^[[:space:]]*($(IFS='|'; echo "${keys[*]}"|sed 's/colour/colou?r/g'))[[:space:]]*:"
    for conf in "${LIMINE_CONFS[@]}"; do
        [[ -f $conf ]] || continue
        found=1
        [[ -f $conf.pre-noctalia ]] || cp "$conf" "$conf.pre-noctalia"
        # drop the previous managed block and any stray copies of our keys,
        # then put the fresh block at the top (colour options are global)
        { printf '%s\n' "$block"
          sed -E -e '/^# >>> noctalia colours/,/^# <<< noctalia colours/d' \
                 -e "/${key_re}/Id" "$conf"
        } >"$conf.tmp"
        cat "$conf.tmp" >"$conf"
        rm -f "$conf.tmp"
        echo "limine: updated $conf"
    done
    [[ $found == 1 ]] || echo "limine: no limine.conf found, skipped" >&2
}

apply_sddm
apply_limine
