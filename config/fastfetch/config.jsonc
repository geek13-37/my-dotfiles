{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 0,
      "right": 2
    },
    "color": {
      "1": "#cb63f7",
      "2": "#fab363"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#cba6f7",
      "title": "#fab387"
    },
    "percent": {
      "color": {
        "green": "#94e2d5",
        "yellow": "#bb8af4",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "format": "{all}"
    },
    {
      "type": "memory",
      "key": "Mem",
      "format": "{used} / {total}"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
