{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 0,
      "right": 2
    },
    "color": {
      "1": "#769463",
      "2": "#c0a363"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#76946a",
      "title": "#c0a36e"
    },
    "percent": {
      "color": {
        "green": "#7e9cd8",
        "yellow": "#ade996",
        "red": "#c34043"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "blue"
      }
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "format": "{all}"
    },
    {
      "type": "memory",
      "key": "Mem",
      "format": "{used} / {total}"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
