{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 0,
      "right": 2
    },
    "color": {
      "1": "#63b6f2",
      "2": "#5581d9"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#99b6f2",
      "title": "#5581d9"
    },
    "percent": {
      "color": {
        "green": "#4e6ba6",
        "yellow": "#8eaef1",
        "red": "#d98886"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "at": "white",
        "host": "blue"
      }
    },
    { "type": "os", "key": "OS", "format": "{name}" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Pkgs", "format": "{all}" },
    { "type": "memory", "key": "Mem", "format": "{used} / {total}" },
    { "type": "colors", "symbol": "circle" }
  ]
}
