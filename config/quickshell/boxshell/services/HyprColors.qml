pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import qs

// Hyprland's colours (window borders, groups, shadows) from the wallpaper. Applied live with
// `hyprctl eval`, and saved to ~/.cache/boxshell/hyprland.lua, which
// hyprland.lua loads so they survive a Hyprland restart.
Singleton {
    id: root

    function rgb(c: color): string {
        return `rgb(${c.toString().slice(1)})`
    }
    function rgba(c: color, alpha: real): string {
        const a = Math.round(alpha * 255).toString(16).padStart(2, "0")
        return `rgba(${c.toString().slice(1)}${a})`
    }

    readonly property string lua: `hl.config({
    general = {
        col = {
            active_border = "${rgb(Theme.accent)}",
            inactive_border = "${rgb(Theme.surface)}",
        },
    },
    decoration = {
        shadow = {
            color = "${rgba(Theme.bg, 0.6)}",
        },
    },
    group = {
        col = {
            border_active = "${rgb(Theme.accent)}",
            border_inactive = "${rgb(Theme.surface)}",
        },
        groupbar = {
            col = {
                active = "${rgb(Theme.accent)}",
                inactive = "${rgb(Theme.surface)}",
            },
            text_color = "${rgb(Theme.accentText)}",
            text_color_inactive = "${rgb(Theme.fg)}",
        },
    },
})
`
    // colours change one by one when the palette switches; apply once at the end
    onLuaChanged: applyLater.restart()

    Timer {
        id: applyLater
        interval: 200
        onTriggered: {
            // fallback colours until the palette is ready; don't touch Hyprland yet
            if (!Theme.p) return
            file.setText("-- Generated by boxshell from the wallpaper; edits get overwritten.\n" + root.lua)
            // no leading "--" comment here: hyprctl would take it for a flag
            Quickshell.execDetached(["hyprctl", "eval", root.lua])
        }
    }

    FileView {
        id: file
        path: Quickshell.env("HOME") + "/.cache/boxshell/hyprland.lua"
        printErrors: false
    }
}
